#!/bin/sh
# ============================================================
# laOra · dos guardias antes de cada commit
# ------------------------------------------------------------
# Se instala una vez con:  git config core.hooksPath .githooks
# ============================================================

# ---------- 1. el catálogo del servidor, al día ----------
# El servidor valida los precios contra `catalogo-2026.json`, que se
# saca EJECUTANDO el motor de precios de cada ficha. Si una ficha
# cambia y ese archivo no, el carrito empieza a decir «esa referencia
# ya no está a la venta» y nadie se entera hasta que alguien compra.
# Acordarse a mano no funciona —Óscar, 19/08/2026: «el catálogo va a
# estar cambiando toda la semana a cada hora»—, así que se hace solo.
fichas=$(git diff --cached --name-only | grep -E '^(precisa|trinchera|lunar|bitacora)\.html$|^assets/img/lunar-config/manifest\.json$')
if [ -n "$fichas" ]; then
  echo "→ ha cambiado una ficha: volviendo a volcar el catálogo"
  if node herramientas/volcar_catalogo_2026.js; then
    git add assets/datos/catalogo-2026.json
    # Y los precios que la colección lleva escritos dentro: si la
    # tarjeta dice 249,90 y el servidor cobra 259,90, el cliente ve un
    # precio y paga otro. No es un descuadre estético.
    node herramientas/sincronizar_precios.js && git add coleccion.html
  else
    echo "⚠️  el volcador ha fallado. El commit sigue, pero el catálogo del"
    echo "    servidor se queda como estaba: revísalo antes de vender."
  fi
fi

# ---------- 2. las fotos rehechas, con número nuevo ----------
# Una foto que se rehace conservando el nombre NO LE LLEGA A NADIE: el
# navegador y Cloudflare la tienen guardada por ese nombre. El
# 20/08/2026 Óscar seguía viendo el logotipo del Murph en el sitio de
# antes, tres despliegues después de haberlo movido. Acordarse a mano de
# subir el `?v=` no funciona, así que se sube solo.
if git diff --cached --name-only | grep -q '^assets/img/trinchera-2026/serie/'; then
  v=$(sed -n "s/.*var SERIE_V = '?v=\([0-9]*\)';.*/\1/p" trinchera.html)
  if [ -n "$v" ]; then
    nueva=$((v + 1))
    sed -i '' "s/var SERIE_V = '?v=$v';/var SERIE_V = '?v=$nueva';/" trinchera.html
    git add trinchera.html
    # Y las fotos de la serie que otras páginas llevan ESCRITAS —las
    # miniaturas de la colección—, que el 20/08/2026 se quedaron en la
    # v14 mientras la ficha iba por la 18: Óscar veía el ante viejo.
    for h in *.html; do
      if grep -q 'trinchera-2026/serie/.*avif?v=' "$h"; then
        sed -i '' "s|\(trinchera-2026/serie/[^\"']*avif\)?v=[0-9]*|\1?v=$nueva|g" "$h"
        git add "$h"
      fi
    done
    echo "→ fotos de la serie rehechas: SERIE_V pasa a $nueva (ficha y miniaturas)"
  fi
fi

# ---------- 3. fotos del Trinchera fuera de la serie ----------
# La serie de 2026 vive entera en `serie/`, y es la única que se rehace
# cuando cambia una esfera. Lo que quedó fuera —la galería, las
# miniaturas antiguas— no se entera de nada y se queda congelado: el
# 20/08/2026 Óscar seguía viendo el Murph de hace una semana en la
# colección después de rehacer cien fotos, porque su tarjeta apuntaba a
# `murph/` y a `1200/`, no a `serie/`.
viejas=$(grep -oh '/assets/img/trinchera-2026/\(1200\|murph\)/[a-z0-9/-]*\.\(webp\|avif\)' ./*.html 2>/dev/null | sort -u)
if [ -n "$viejas" ]; then
  echo "ℹ️  fotos del Trinchera que NO son de la serie (no se rehacen solas):"
  echo "$viejas" | sed 's/^/   /'
fi

# ---------- 4. la misma versión en todas las páginas ----------
# Cloudflare sirve el JS y el CSS con max-age=14400, así que el `?v=`
# es lo único que obliga al navegador a bajarse la versión nueva. El
# 19/08/2026 nueve páginas pedían `carrito.js?v=1` mientras el carrito
# pedía la 11: quien añadía a la cesta estaba usando código de días
# atrás. Esto lo canta antes de que se publique.
descuadre=$(grep -oh '[a-z0-9-]*\.\(js\|css\)?v=[0-9]*' ./*.html 2>/dev/null \
  | sort -u \
  | sed 's/?v=/ /' \
  | awk '{c[$1]=c[$1]" "$2} END {for (f in c) {n=split(c[f],v," "); if (n>1) print "   " f ":" c[f]}}')
if [ -n "$descuadre" ]; then
  echo "⚠️  el mismo archivo se pide con versiones distintas según la página:"
  echo "$descuadre"
  echo "   El navegador se quedará con la vieja donde el número sea menor."
fi

exit 0
