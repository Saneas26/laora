#!/bin/sh
# ============================================================
# laOra · dos guardias antes de cada commit
# ------------------------------------------------------------
# Se instala una vez con:  git config core.hooksPath .githooks
# ============================================================

# ---------- 1. el catálogo del servidor, al día ----------
# El servidor valida los precios contra `catalogo-2026.json`, que se
# saca EJECUTANDO el motor de precios de cada ficha. Si una ficha
# cambia y ese archivo no, el carrito empieza a decir «esa referencia
# ya no está a la venta» y nadie se entera hasta que alguien compra.
# Acordarse a mano no funciona —Óscar, 19/08/2026: «el catálogo va a
# estar cambiando toda la semana a cada hora»—, así que se hace solo.
# EL CONTRATO DE PASOS Y SU COPIA DENTRO DEL MOTOR. El motor lleva una copia
# literal de `assets/datos/pasos-2026.json` porque pinta antes de que el
# cliente vea nada y además corre fuera del navegador cuando se vuelca el
# catálogo. Si alguien toca el JSON y no pasa el sincronizador, la ficha se
# queda con unos pasos y el contrato dice otros. Esto lo caza aquí.
if git diff --cached --name-only | grep -qE '^assets/(datos/pasos-2026\.json|js/configurador-2026\.js)$'; then
  python3 herramientas/sincronizar_pasos.py --comprobar || exit 1
fi

# CUALQUIER FICHA, no una lista de cuatro nombres. Las fichas generadas
# salen de `assets/datos/fichas/*.json`, así que tocar un JSON también mueve
# el catálogo aunque el HTML no aparezca todavía en el commit.
fichas=$(git diff --cached --name-only | grep -E '^(precisa|trinchera|lunar|bitacora|cero-cero|coctel|tortuga|diver|medusa|barlovento)\.html$|^assets/datos/fichas/.*\.json$|^assets/js/(configurador|precio)-2026\.js$|^assets/img/lunar-config/manifest\.json$')
if [ -n "$fichas" ]; then
  echo "→ ha cambiado una ficha: volviendo a volcar el catálogo"
  if node herramientas/volcar_catalogo_2026.js; then
    git add assets/datos/catalogo-2026.json
    # Y los precios que la colección lleva escritos dentro: si la
    # tarjeta dice 249,90 y el servidor cobra 259,90, el cliente ve un
    # precio y paga otro. No es un descuadre estético.
    node herramientas/sincronizar_precios.js && git add coleccion.html
  else
    echo "⚠️  el volcador ha fallado. El commit sigue, pero el catálogo del"
    echo "    servidor se queda como estaba: revísalo antes de vender."
  fi
fi

# ---------- 2. (vacío) ----------
# AQUÍ HABÍA DOS GUARDIAS DE LAS FOTOS DEL TRINCHERA y se fueron el
# 29/08/2026 con su configurador viejo. Uno subía el `SERIE_V` de
# `trinchera.html` cuando cambiaba algo de `serie/` —para que Cloudflare no
# siguiera sirviendo la foto de antes— y el otro cantaba las fotos que se
# habían quedado fuera de la serie.
#
# Los dos vigilaban una ficha que llevaba dentro 93 fotos escritas a mano y
# una variable de versión. La ficha generada no tiene ninguna de las dos
# cosas: se arma con las piezas de la biblioteca. El día que el Trinchera
# vuelva a tener fotos propias, el guardia se escribe otra vez, y sabiendo
# por qué: sin él, una foto rehecha con el mismo nombre no le llega a nadie.

# ---------- 4. la misma versión en todas las páginas ----------
# Cloudflare sirve el JS y el CSS con max-age=14400, así que el `?v=`
# es lo único que obliga al navegador a bajarse la versión nueva. El
# 19/08/2026 nueve páginas pedían `carrito.js?v=1` mientras el carrito
# pedía la 11: quien añadía a la cesta estaba usando código de días
# atrás. Esto lo canta antes de que se publique.
descuadre=$(grep -oh '[a-z0-9-]*\.\(js\|css\)?v=[0-9]*' ./*.html 2>/dev/null \
  | sort -u \
  | sed 's/?v=/ /' \
  | awk '{c[$1]=c[$1]" "$2} END {for (f in c) {n=split(c[f],v," "); if (n>1) print "   " f ":" c[f]}}')
if [ -n "$descuadre" ]; then
  echo "⚠️  el mismo archivo se pide con versiones distintas según la página:"
  echo "$descuadre"
  echo "   El navegador se quedará con la vieja donde el número sea menor."
fi

exit 0
